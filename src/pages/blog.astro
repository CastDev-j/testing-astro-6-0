---
import Layout from "@layout/Layout.astro";
---

<Layout title="Home">
  <section class="max-w-5xl px-4 py-8 flex flex-col items-center gap-6">
    <ul class="flex justify-center w-full gap-6">
      <li>
        <a
          class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 transition-colors"
          href="/posts/post-1">Post 1</a
        >
      </li>
      <li>
        <a
          class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 transition-colors"
          href="/posts/post-2">Post 2</a
        >
      </li>
      <li>
        <a
          class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 transition-colors"
          href="/posts/post-3">Post 3</a
        >
      </li>
    </ul>

    <article class="w-full flex flex-col items-center gap-6">
      <p>
        This is the homepage of my Astro site. I'm still working through the
        tutorial, but I'm excited to see how it turns out!
      </p>
    </article>
  </section>
</Layout>
