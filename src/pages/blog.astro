---
import type { Post } from "@interfaces/post";
import Layout from "@layout/Layout.astro";

const allPosts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true }),
) as {
  url: string;
  frontmatter: Post;
}[];

const pageTitle = "Blog";
---

<Layout title={pageTitle}>
  <section class="max-w-5xl w-full p-4">
    <h1 class="text-2xl font-bold">{pageTitle}</h1>
  </section>

  <section class="w-full p-4 flex flex-col items-stretch justify-between">
    <article class="flex justify-center w-full gap-8 flex-wrap">
      {
        allPosts.map((post) => (
          <a
            class="w-full max-w-max md:max-w-2xs flex flex-col items-center gap-4 outline-2 outline-offset-8 outline-current/20 rounded-sm hover:outline-indigo-500 transition-all"
            href={post.url}
          >
            <img
              src={post.frontmatter.image.url}
              alt={post.frontmatter.title}
              class="w-full h-auto rounded-lg"
            />
            <h2 class="text-2xl font-semibold">{post.frontmatter.title}</h2>
            <p class="text-gray-500 text-sm">
              By {post.frontmatter.author} on{" "}
              {new Date(post.frontmatter.pubDate).toLocaleDateString()}
            </p>
          </a>
        ))
      }
    </article>
  </section>
</Layout>
