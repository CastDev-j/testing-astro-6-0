---
import BlogPost from "@components/blog/BlogPost.astro";
import type { PostGlob } from "@interfaces/post";
import Layout from "@layout/Layout.astro";

const allPosts = Object.values(
  import.meta.glob<PostGlob>("./posts/*.md", { eager: true }),
);

const pageTitle = "Blog";
---

<Layout title={pageTitle}>
  <section class="max-w-5xl w-full p-4">
    <h1 class="text-2xl font-bold">{pageTitle}</h1>
  </section>

  <section class="w-full p-4 flex flex-col items-stretch justify-between">
    <article
      class="grid w-full gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3"
    >
      {allPosts.map((post) => <BlogPost post={post} />)}
    </article>
  </section>
</Layout>
