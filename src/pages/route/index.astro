---
export const prerender = false;
import Greeting from "@components/home/Greeting";
import Layout from "@layout/Layout.astro";

const pageTitle = "Route";

let message = "Type a route and submit the form to navigate to it.";

const error = Astro.url.searchParams.get("error");

if (error) {
  message = "Invalid route. Please enter a valid route.";
}
---

<Layout title={pageTitle}>
  <section class="max-w-5xl w-full p-4">
    <article class="w-full flex flex-col items-center gap-6">
      <h1 class="text-2xl font-bold" transition:name="title">
        {pageTitle}
      </h1>
    </article>
  </section>

  <section
    class="max-w-5xl w-full p-4 flex flex-col gap-4 items-center justify-center"
  >
    <form class="route-form flex flex-col gap-4 max-w-sm w-full">
      <label for="route">{message}</label>
      <div class="flex gap-2">
        <input
          type="text"
          name="route"
          class="bg-bg-secondary text-text-primary placeholder:text-text-tertiary px-2 py-3 rounded-sm w-full"
          placeholder="Route"
        />
        <button
          type="submit"
          class="bg-button-primary-bg hover:bg-button-primary-bg-hover text-button-primary-text px-4 py-3 transition-colors rounded-sm"
        >
          Go
        </button>
      </div>
    </form>
  </section>

  <section class="max-w-5xl w-full p-4 flex items-center justify-center">
    <Greeting
      transition:persist
      transition:persist-props
      transition:name="greeting"
      client:load
      messages={[
        "Hello, World!",
        "Welcome to my Astro site!",
        "Astro is awesome!",
        "Have a great day!",
      ]}
    />
  </section>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";

  const loadForm = () => {
    const form = document.querySelector(".route-form") as HTMLFormElement;

    if (!form) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const route = formData.get("route") as string;

      if (route) {
        navigate(`/route/${route}`);
      } else {
        navigate("/route?error=1");
      }
    });
  };

  document.addEventListener("astro:page-load", loadForm);
</script>
