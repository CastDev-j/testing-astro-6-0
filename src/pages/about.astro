---
import Layout from "@layout/Layout.astro";
import { cn } from "@lib/cn";
import { Certificates, socials } from "src/config";

const pageTitle = "About Me";
---

<Layout title={pageTitle}>
  <section class="max-w-5xl w-full p-4">
    <h1 class="text-2xl font-bold">{pageTitle}</h1>
  </section>

  <section class="max-w-5xl w-full p-4 flex flex-col gap-2">
    <article class="w-full flex flex-col gap-4">
      <ul class="flex flex-wrap gap-4">
        {
          socials.map((social) => (
            <li>
              <a
                target="_blank"
                class={cn(
                  "flex items-center gap-4 px-4 py-2  transition-colors rounded-sm border",
                  " hover:bg-indigo-50 border-indigo-200",
                  " dark:hover:bg-gray-700 dark:border-gray-600",
                )}
                href={social.href}
              >
                {social.name} | {social.text}
              </a>
            </li>
          ))
        }
      </ul>
    </article>

    <article class="w-full flex flex-col gap-4">
      <h2 class="mt-8">Certificates</h2>

      <ul class="flex flex-wrap gap-4">
        {
          Certificates.map((certificate) => (
            <li>
              <a
                target="_blank"
                class={cn(
                  "flex items-center gap-4 px-4 py-2 bg-transparent transition-colors rounded-sm border",
                  "hover:bg-indigo-100 border-indigo-200",
                  "dark:hover:bg-gray-700 dark:border-gray-600",
                )}
                href={certificate.url}
              >
                <img
                  src={certificate.logo}
                  alt={`${certificate.title} logo`}
                  class="w-6 h-6"
                />
                {certificate.title}
              </a>
            </li>
          ))
        }
      </ul>
    </article>
  </section>
</Layout>
