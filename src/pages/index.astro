---
export const prerender = false;
import Greeting from "@components/home/Greeting";
import Layout from "@layout/Layout.astro";

const pageTitle = "Home";

const dataMessage = "This is some data passed from the server.";

const number = Astro.url.searchParams.get("number");
const data = Astro.locals;
---

<Layout title={pageTitle}>
  <section class="max-w-5xl w-full p-4">
    <article class="w-full flex flex-col items-center gap-6">
      <h1 class="text-2xl font-bold" transition:name="title">
        {pageTitle}
      </h1>
      <div class="counter text-primary">00:00:00 AM</div>
      {number && <p>Number: {number}</p>}
      {data && <p>Data: {data.title}</p>}
      <astro-greet data-message={dataMessage} class="flex gap-2 items-center">
        <button>Say hi!</button>
        <span class="hidden"></span>
      </astro-greet>

      <button
        class="confetti bg-button-primary-bg text-button-primary-text px-4 py-2 rounded hover:bg-button-primary-bg-hover transition-colors"
      >
        Click Me
      </button>
    </article>
  </section>

  <section class="max-w-5xl w-full p-4 flex items-center justify-center">
    <Greeting
      transition:persist
      transition:persist-props
      transition:name="greeting"
      client:load
      messages={[
        "Hello, World!",
        "Welcome to my Astro site!",
        "Astro is awesome!",
        "Have a great day!",
      ]}
    />
  </section>
</Layout>

<script>
  class AstroGreet extends HTMLElement {
    connectedCallback() {
      const message = this.dataset.message;
      const span = this.querySelector("span") as HTMLSpanElement;
      const button = this.querySelector("button") as HTMLButtonElement;

      button.addEventListener("click", () => {
        span.classList.toggle("hidden");
        span.innerHTML = message || "Hello!";
      });
    }
  }

  customElements.define("astro-greet", AstroGreet);
</script>

<script>
  import confetti from "canvas-confetti";
  let intervalId: NodeJS.Timeout | null = null;

  const loadClock = () => {
    const counter = document.querySelector(".counter") as HTMLDivElement;

    if (!counter) return;

    counter.textContent = new Date().toLocaleTimeString();

    intervalId = setInterval(() => {
      counter.textContent = new Date().toLocaleTimeString();
    }, 1000);
  };

  const cleanupClock = () => {
    if (intervalId) {
      clearInterval(intervalId);
    }
  };

  const loadConfettiButton = () => {
    const button = document.querySelector(".confetti") as HTMLButtonElement;

    button.addEventListener("click", () => confetti());
  };

  document.addEventListener("astro:page-load", () => {
    loadClock();
    loadConfettiButton();
  });
  document.addEventListener("astro:before-swap", cleanupClock);
</script>
