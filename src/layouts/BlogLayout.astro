---
import type { PostGlob } from "@interfaces/post";
import Layout from "./Layout.astro";
import { cn } from "@lib/cn";

const posts = Object.values(
  import.meta.glob<PostGlob>("../pages/posts/*.md", { eager: true }),
);

const tags = [...new Set(posts.flatMap((p) => p.frontmatter.tags))];

interface Props {
  title: string;
}

const pathname = Astro.url.pathname.split("/")[2] || "";

const { title } = Astro.props;
---

<Layout title={title}>
  <section class="w-full p-4 flex flex-col items-stretch justify-between">
    <article class="flex flex-wrap w-full gap-4">
      {
        tags.map((tag) => (
          <a
            href={`/tags/${tag.replace(/\s+/g, "-").toLowerCase()}`}
            class={cn(
              "px-2 py-1 text-lg outline-2 outline-dotted rounded-lg hover:outline-indigo-500 hover:text-indigo-500 transition-colors duration-200",
              pathname === tag.replace(/\s+/g, "-").toLowerCase() &&
                "outline-indigo-500 text-indigo-500",
            )}
          >
            {tag}
          </a>
        ))
      }
    </article>
  </section>

  <div class="post-content min-h-48 flex flex-col items-start max-w-5xl w-full">
    <slot />
  </div>
</Layout>
