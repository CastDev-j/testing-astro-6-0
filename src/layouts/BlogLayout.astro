---
import type { PostGlob } from "@interfaces/post";
import Layout from "./Layout.astro";
import { cn } from "@lib/cn";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");

const posts: PostGlob[] = allPosts.map((p) => ({
  url: `/posts/${p.id}`,
  frontmatter: p.data,
}));

const tags = [...new Set(posts.flatMap((p) => p.frontmatter.tags))];

interface Props {
  title: string;
}

const pathname = Astro.url.pathname.split("/")[2] || "";

const { title } = Astro.props;
---

<Layout title={title}>
  <section class="w-full p-4 flex flex-col items-stretch justify-between">
    <article class="flex flex-wrap w-full gap-4">
      {
        tags.map((tag) => (
          <a
            href={`/tags/${tag.replace(/\s+/g, "-").toLowerCase()}`}
            class={cn(
              "px-2 py-1 text-lg outline-2 outline-dotted rounded-lg transition-colors duration-200",
              "hover:outline-indigo-500 hover:text-indigo-500",
              "dark:hover:outline-indigo-300 dark:hover:text-indigo-300",
              pathname === tag.replace(/\s+/g, "-").toLowerCase() &&
                "border-b-indigo-500 text-indigo-500 dark:border-b-indigo-300 dark:text-indigo-300",
            )}
          >
            {tag}
          </a>
        ))
      }
    </article>
  </section>

  <div class="post-content min-h-48 flex flex-col items-start max-w-5xl w-full">
    <slot />
  </div>
</Layout>
