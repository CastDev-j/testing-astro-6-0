---
import Layout from "./Layout.astro";
import { cn } from "@lib/cn";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

interface Props {
  title: string;
}

const pathname = Astro.url.pathname.split("/")[2] || "";

const { title } = Astro.props;
---

<Layout title={title}>
  <section class="w-full p-4 flex flex-col items-stretch justify-between">
    <article class="flex flex-wrap w-full gap-2">
      {
        tags.map((tag) => (
          <a
            href={`/tags/${tag.replace(/\s+/g, "-").toLowerCase()}`}
            class={cn(
              "px-2 py-0.5 text-xs outline-2 outline-dotted rounded-lg transition-colors duration-200 hover:outline-primary hover:text-primary",
              pathname === tag.replace(/\s+/g, "-").toLowerCase() &&
                "border-b-primary text-primary",
            )}
          >
            {tag}
          </a>
        ))
      }
    </article>
  </section>

  <div class="post-content min-h-48 flex flex-col items-start max-w-5xl w-full">
    <slot />
  </div>
</Layout>
