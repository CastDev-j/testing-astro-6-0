---
import HeroPost from "@components/blog/HeroPost.astro";
import Layout from "./Layout.astro";
import type { Post } from "@interfaces/post";
import type { MarkdownHeading } from "astro";
import SideBarPost from "@components/blog/SideBarPost.astro";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
---

<Layout title={post.title} class="max-w-6xl">
  <div class="grid grid-cols-12 gap-4">
    <div class="md:col-span-10 col-span-12">
      <HeroPost {...post} />
      <div
        class="post-content min-h-48 flex flex-col items-start max-w-5xl w-full"
      >
        <slot />
      </div>
    </div>
    <div class="col-span-2 hidden md:block mt-16">
      <SideBarPost post={post} headings={headings} />
    </div>
  </div>
</Layout>

<script>
  const COPY_ICON = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none">
    <path d="M16 1H4C2.9 1 2 1.9 2 3V17H4V3H16V1ZM19 5H8C6.9 5 6 5.9 6 7V21C6 22.1 6.9 23 8 23H19C20.1 23 21 22.1 21 21V7C21 5.9 20.1 5 19 5Z" fill="currentColor"/>
  </svg>`;

  const CHECK_ICON = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none">
    <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>`;

  function animateSwap(button: HTMLElement, newIcon: string) {
    button.style.transition = "opacity 0.15s ease, transform 0.15s ease";
    button.style.opacity = "0";
    button.style.transform = "scale(0.7)";

    setTimeout(() => {
      button.innerHTML = newIcon;
      button.style.opacity = "1";
      button.style.transform = "scale(1)";
    }, 150);
  }

  function initCopyButtons() {
    document.querySelectorAll(".post-content pre.astro-code").forEach((pre) => {
      const code = pre.querySelector("code")!.innerText;

      const wrapper = document.createElement("div");
      wrapper.className = "code-block-wrapper";
      wrapper.style.cssText =
        "position: relative; width: 100%; margin-bottom: 1rem;";

      const header = document.createElement("div");
      header.className = "code-header";
      header.style.cssText =
        "position: absolute; top: 1rem; right: 1rem; z-index: 10; display: flex; align-items: center; gap: 0.5rem;";

      const button = document.createElement("button");
      button.className = "copy-btn";
      button.innerHTML = COPY_ICON;
      button.style.cssText =
        "background: none; border: none; cursor: pointer; padding: 0; display: flex; align-items: center; justify-content: center; color: currentColor;";

      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(code);
        animateSwap(button, CHECK_ICON);
        setTimeout(() => animateSwap(button, COPY_ICON), 2000);
      });

      header.appendChild(button);
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);
      wrapper.appendChild(header);
    });
  }

  document.addEventListener("astro:page-load", initCopyButtons);
</script>

<style>
  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    font-weight: bold;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .post-content :global(h1) {
    font-size: 2.25rem;
    line-height: 2.5rem;
  }
  .post-content :global(h2) {
    font-size: 1.875rem;
    line-height: 2.25rem;
  }
  .post-content :global(h3) {
    font-size: 1.5rem;
    line-height: 2rem;
  }
  .post-content :global(h4) {
    font-size: 1.25rem;
    line-height: 1.75rem;
  }
  .post-content :global(h5) {
    font-size: 1.125rem;
    line-height: 1.75rem;
  }
  .post-content :global(h6) {
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .post-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.625;
  }

  .post-content :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .post-content :global(ol) {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(a) {
    color: #2563eb;
    text-decoration: underline;
    transition: color 0.2s;
  }
  .post-content :global(a:hover) {
    color: #1e40af;
  }

  :global(.dark) .post-content :global(a) {
    color: #a5b4fc;
  }
  :global(.dark) .post-content :global(a:hover) {
    color: #818cf8;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid #d1d5db;
    padding-left: 1rem;
    font-style: italic;
    color: #4b5563;
    margin-bottom: 1rem;
  }

  :global(.dark) .post-content :global(blockquote) {
    border-left: 4px solid #374151;
    color: #9ca3af;
  }

  .post-content :global(pre) {
    background: #111827;
    color: #f3f4f6;
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 1rem;
    overflow-x: auto;
  }

  :global(.dark) .post-content :global(pre) {
    background: #1e293b;
    color: #f3f4f6;
  }

  .post-content :global(code) {
    background: #e6e8ed;
    color: #db2777;
    border-radius: 0.25rem;
    padding: 0.125rem 0.25rem;
    font-family: monospace;
    font-size: 0.875rem;
  }

  :global(.dark) .post-content :global(code) {
    background: #334155;
    color: #f472b6;
  }

  .post-content :global(pre code) {
    background: transparent !important;
    color: inherit;
    border-radius: 0;
    padding: 0;
    font-size: inherit;
  }

  :global(.astro-code) {
    width: 100%;
    font-size: 0.875rem;
    position: relative;
  }

  :global(.dark .post-content .astro-code),
  :global(.dark .post-content .astro-code span),
  :global(.dark .post-content pre.astro-code),
  :global(.dark .post-content pre.astro-code span) {
    color: var(--shiki-dark) !important;
    background: var(--shiki-dark-bg) !important;
  }

  :global(.dark .post-content pre.astro-code[style]) {
    background: var(--shiki-dark-bg) !important;
    color: var(--shiki-dark) !important;
  }

  .post-content :global(img) {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 0.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    max-width: 100%;
    height: auto;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid #e5e7eb;
    padding: 0.5rem 1rem;
  }
  :global(.dark) .post-content :global(th),
  :global(.dark) .post-content :global(td) {
    border: 1px solid #374151;
  }

  .post-content :global(th) {
    background: #f3f4f6;
    font-weight: 600;
  }
  :global(.dark) .post-content :global(th) {
    background: #1e293b;
    color: #f3f4f6;
  }
</style>
