---
import type { Post } from "@interfaces/post";
import { Image } from "astro:assets";

interface Props extends Post {}

const { title, pubDate, description, author, image, tags } = Astro.props;
---

<article class="max-w-5xl w-full py-4 flex flex-col gap-2 items-center">
  <a
    href="/blog"
    class="self-start text-indigo-600 px-2 py-3 hover:text-indigo-800 text-sm flex items-center gap-2 transition-colors duration-200 font-medium group"
    aria-label="Go back to blog"
  >
    &#x276E; Go back to blog
  </a>

  <Image
    src={image.url}
    alt={image.alt}
    width="256"
    height="160"
    class="w-full h-auto rounded-lg min-w-3xs min-h-40"
    loading="eager"
    transition:name={title + "1"}
  />

  <p class="text-gray-500 text-sm self-start" transition:name={title + "3"}>
    By {author} on {new Date(pubDate).toLocaleDateString()}
  </p>
  <h1 class="text-3xl font-bold" transition:name={title + "2"}>
    {title}
  </h1>
  <p>
    {description}
  </p>
  <ul class="flex gap-2 my-2 self-start">
    {
      tags.map((tag) => (
        <li>
          <a href={`/tags/${tag}`} class="px-2 py-1 bg-gray-200 rounded">
            {tag}
          </a>
        </li>
      ))
    }
  </ul>
</article>
