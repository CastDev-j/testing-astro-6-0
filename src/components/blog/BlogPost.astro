---
import type { Post } from "@interfaces/post";
import { cn } from "@lib/cn";
import { Image } from "astro:assets";

interface Props {
  url: string;
  post: Post;
}

const { url, post } = Astro.props;
---

<a
  class={cn(
    "w-full max-w-xl md:max-w-2xs flex flex-col items-center outline-2 outline-current/20 rounded-b-sm transition-all hover:outline-primary",
  )}
  href={url}
>
  <Image
    src={post.image.url}
    alt={post.title}
    width="256"
    height="160"
    class="w-full h-auto"
    loading="eager"
    transition:name={post.title + "1"}
  />

  <div class="p-4 flex flex-col items-start gap-2">
    <h2 class="text-2xl font-semibold" transition:name={post.title + "2"}>
      {post.title}
    </h2>
    <p class="text-gray-500 text-sm" transition:name={post.title + "3"}>
      By {post.author} on{" "}
      {new Date(post.pubDate).toLocaleDateString()}
    </p>
  </div>
</a>
