---
import { cn } from "@lib/cn";
import { routes } from "src/config";

const pathname = Astro.url.pathname;
---

<header class={cn("w-full flex justify-center my-4")}>
  <nav>
    <ul class="flex gap-6 flex-wrap justify-center">
      {
        routes.map((route) => (
          <li class="list-none">
            <a
              data-astro-reload
              class={cn(
                "text-xl px-5 py-3 border-b-2 transition-colors",
                "hover:border-b-indigo-500 hover:text-indigo-500",
                "dark:hover:border-b-indigo-300 dark:hover:text-indigo-300",
                route.activePaths.some((activePath) =>
                  activePath === "/"
                    ? pathname === "/"
                    : pathname.startsWith(activePath),
                )
                  ? "border-b-indigo-500 text-indigo-500 dark:border-b-indigo-300 dark:text-indigo-300"
                  : "border-transparent",
              )}
              href={route.href}
            >
              {route.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
