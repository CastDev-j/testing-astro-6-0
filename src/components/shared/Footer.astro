---
import { socials } from "src/config";
---

<footer class="mt-auto w-full">
  <p class="text-center text-sm text-gray-500 py-4">
    &copy; {new Date().getFullYear()} Testing Astro. All rights reserved.
  </p>

  <ul class="flex justify-center gap-4 mb-4">
    {
      socials.map(({ name, href }) => (
        <li>
          <a
            target="_blank"
            class="text-gray-500 hover:text-gray-700 transition-colors"
            href={href}
          >
            {name}
          </a>
        </li>
      ))
    }
  </ul>
</footer>
