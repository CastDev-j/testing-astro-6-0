---
import { socials } from "src/config";
import ThemeIcon from "./ThemeIcon.astro";
import { cn } from "@lib/cn";
---

<footer
  class={cn(
    "mt-auto w-full flex flex-col items-center gap-2 bg-bg-primary text-text-primary",
  )}
>
  <div class="flex flex-col items-center gap-2">
    <p class="text-center text-sm">
      &copy; {new Date().getFullYear()} Testing Astro. All rights reserved.
    </p>

    <ThemeIcon />
  </div>

  <ul class="flex justify-center gap-4 mb-4">
    {
      socials.map(({ name, href }) => (
        <li>
          <a
            target="_blank"
            class={cn(
              "text-text-secondary hover:text-text-secondary-hover transition-colors",
            )}
            href={href}
          >
            {name}
          </a>
        </li>
      ))
    }
  </ul>
</footer>
