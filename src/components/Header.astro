---
import { cn } from "@lib/cn";

const routes = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Contact", href: "/contact" },
];

const pathname = Astro.url.pathname;
---

<header class="w-full flex justify-center my-4">
  <nav>
    <ul class="flex gap-6">
      {
        routes.map((route) => (
          <li class="list-none">
            <a
              class={cn(
                "text-xl px-5 py-3 border-b-2 hover:border-b-indigo-500 hover:text-indigo-500 transition-colors",
                route.href === pathname
                  ? "border-b-indigo-500 text-indigo-500"
                  : "border-transparent",
              )}
              href={route.href}
            >
              {route.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
