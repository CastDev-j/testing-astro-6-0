---
console.log("This runs in your terminal, not the browser!");

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="p-4">
  <article class="w-screen flex flex-col items-center gap-6">
    <h1 class="text-2xl">{title}</h1>
    <div class="counter">00:00:00 AM</div>
  </article>
</section>

<script>
  const counter = document.querySelector(".counter") as HTMLDivElement;

  counter.textContent = new Date().toLocaleTimeString();

  setInterval(() => {
    counter.textContent = new Date().toLocaleTimeString();
  }, 1000);
</script>
